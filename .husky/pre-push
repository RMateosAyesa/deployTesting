#!/usr/bin/env sh

if [ -f .nvmrc ] && [ -d "$HOME/.nvm" ]; then
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" >/dev/null 2>&1
  nvm use >/dev/null 2>&1 || true
fi

BASE="origin/feature/opmdns-data-visualisation"
MERGE_BASE="$(git merge-base HEAD "$BASE" 2>/dev/null || true)"
[ -z "$MERGE_BASE" ] && MERGE_BASE="$BASE"

FILES="$(git diff --name-only --diff-filter=ACMR "$MERGE_BASE" HEAD -- '*.ts' '*.tsx' '*.js' '*.jsx' || true)"

if [ -z "$FILES" ]; then
  echo "husky - sin archivos de código modificados, saltando comprobaciones"
  exit 0
fi

echo "husky - eslint sobre $(printf '%s\n' "$FILES" | wc -l | tr -d ' ') archivo(s) nuevo(s)/modificado(s):"
printf '%s\n' "$FILES"
printf '%s\n' "$FILES" | xargs -d '\n' ./node_modules/.bin/eslint || exit 1

echo "husky - ejecutando tests del repositorio..."
npx jest --coverage=false --silent || exit 1
